      },
      {
        "domain_suffix": [
          ".ru",
          ".su",
          ".ru.com",
          ".ru.net",
          "DOMAIN",
          "kudago.com",
          "kinescope.io",
          "redheadsound.studio",
          "plplayer.online",
          "lomont.site",
          "remanga.org",
          "shopstory.live"
        ],
        "domain_keyword": [
          "xn--",
          "miradres",
          "premier",
          "shutterstock",
          "2gis",
          "diginetica",
          "kinescopecdn",
          "researchgate",
          "nextcloud",
