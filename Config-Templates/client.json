          "oracle",
          "blender",
          "drweb",
          "debian",
          "canonical",
          "python",
          "doi",
          "springer",
          "elsevier",
          "sciencedirect",
          "sci-hub",
          "duolingo"
        ],
        "server": "dns-local"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "server": "dns-remote"
      }
    ],
    "final": "dns-local"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "stack": "system",
      "address": [
        "172.19.0.1/28"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "trojan",
      "tag": "proxy",
      "server": "DOMAIN",
      "server_port": 443,
      "password": "TROJAN-PASSWORD",
      "tls": {
        "enabled": true,
        "server_name": "DOMAIN"
      },
      "transport": {
        "type": "ws",
        "path": "/TROJAN-PATH"
      },
      "multiplex": {
        "enabled": true,
        "padding": true
      }
    }
  ],
  "http_clients": [
    {
      "tag": "http-direct"
    },
    {
      "tag": "http-proxy",
      "detour": "proxy"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_http_client": "http-direct",
    "default_domain_resolver": {
      "server": "dns-local",
      "strategy": "prefer_ipv4"
    },
    "rules": [
