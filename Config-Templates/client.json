{
  "log": {
    "level": "fatal",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "tls": {
            "enabled": true,
            "server_name": "one.one.one.one"
        },
        "detour": "proxy"
      },
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "category-ads-all"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "package_name": [
          "ru.oneme.app",
          "com.vkontakte.android",
          "ru.rostel"
        ],
        "server": "dns-local"
      },
      {
        "process_name": [
          "max.exe",
          "max-service.exe",
          "crashpad_handler.exe"
        ],
        "server": "dns-local"
      },
      {
        "rule_set": [
          "torrent-clients"
        ],
        "server": "dns-local"
      },
      {
        "domain_suffix": [
          "kemono.su",
          "jut.su",
          "kara.su",
          "smods.ru",
          "theins.ru",
          "tvrain.ru",
          "echo.msk.ru",
